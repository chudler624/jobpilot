# Supabase project settings (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL used to build the magic-link redirect target.
# http://localhost:3000 for local dev; the deployed Vercel URL in prod/preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini API key from https://aistudio.google.com/apikey (server-only).
GEMINI_API_KEY=
# Model identifier — check current availability before assuming this stays
# valid (see DECISIONS.md ADR-003). "gemini-flash-lite-latest" is a rolling
# alias Google maintains, so it doesn't go stale the way a pinned version does.
GEMINI_MODEL=gemini-flash-lite-latest
